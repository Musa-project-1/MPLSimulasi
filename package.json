    "watch": "tailwindcss -i css/input.css -o css/app.min.css --watch"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "vitest": "^3.0.7"
  }
}
